# Local SQLite persists drafts in api/fundly.db.
DATABASE_URL=sqlite:///./fundly.db

# Optional PostgreSQL/Supabase format (replace placeholders; keep real values in api/.env only).
# DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/postgres?sslmode=require

# AI content generation uses Google's Gemini API from the backend only.
# Create a key in Google AI Studio and put the real value in api/.env, never in source code.
# GEMINI_API_KEY=replace_with_your_gemini_api_key
# GEMINI_MODEL=gemini-3.1-flash-lite
